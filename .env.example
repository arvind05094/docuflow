# Database Configuration (PostgreSQL / Neon)
ConnectionStrings__DefaultConnection="Host=localhost;Database=docuflow;Username=postgres;Password=your_local_password"

# JWT Authentication
JWT__Secret="your_local_super_secret_key_minimum_32_characters_long"
JWT__Issuer="DocuFlowApi"
JWT__Audience="DocuFlowClient"
JWT__ExpiryMinutes=60

# Groq AI Configuration
Groq__ApiKey="your_groq_api_key_here"
Groq__Model="openai/gpt-oss-120b"

# S3 Object Storage (Supabase / Cloudflare R2)
Storage__AccessKey="your_s3_access_key"
Storage__SecretKey="your_s3_secret_key"
Storage__ServiceUrl="https://your-project-id.supabase.co/storage/v1/s3"
Storage__BucketName="docuflow-documents"
Storage__ForcePathStyle="true"

# Email Configuration (MailKit)
Smtp__Host="smtp.example.com"
Smtp__Port=587
Smtp__Username="your_smtp_username"
Smtp__Password="your_smtp_password"
Smtp__SenderEmail="noreply@docuflow.local"

# CORS Settings
Cors__AllowedOrigins="http://localhost:5173"